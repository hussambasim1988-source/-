<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>منصة لمّـة للمناسبات | Lamma App</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body { font-family: 'Tajawal', sans-serif; background-color: #0b1329; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>
<body class="flex items-center justify-center min-h-screen p-0 sm:p-4">

  <!-- إطار شاشة الهاتف -->
  <div class="w-full sm:max-w-[420px] h-screen sm:h-[840px] bg-slate-50 sm:rounded-[40px] shadow-2xl border-0 sm:border-8 border-slate-800 overflow-hidden flex flex-col relative">
    
    <!-- شريط الحالة (Status Bar) -->
    <div class="h-7 bg-slate-900 flex justify-between items-center px-6 text-white text-xs select-none">
      <span class="font-bold">10:30</span>
      <div class="flex gap-2 items-center text-[11px]">
        <i class="fa-solid fa-signal"></i>
        <i class="fa-solid fa-wifi"></i>
        <i class="fa-solid fa-battery-full text-sm"></i>
      </div>
    </div>

    <!-- رأس التطبيق (Header) -->
    <header class="bg-slate-900 text-white px-5 py-3.5 flex justify-between items-center shadow-lg border-b border-slate-800">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-2xl bg-gradient-to-tr from-amber-600 to-amber-400 flex items-center justify-center font-black text-slate-950 text-xl shadow-md">ل</div>
        <div>
          <h1 class="font-extrabold text-base tracking-wide leading-none text-white">لمّــة</h1>
          <span class="text-[10px] text-amber-400 font-medium">كل تفاصيل مناسبتك بلمسة واحدة</span>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <button class="w-8 h-8 rounded-full bg-slate-800 text-slate-300 flex items-center justify-center text-xs relative hover:text-white transition">
          <i class="fa-regular fa-bell"></i>
          <span class="absolute top-1.5 right-1.5 w-2 h-2 bg-amber-500 rounded-full"></span>
        </button>
      </div>
    </header>

    <!-- مساحة الشاشات المتغيرة (Main Screen Viewport) -->
    <main class="flex-1 overflow-y-auto no-scrollbar p-4 space-y-4" id="main-content">

      <!-- ========================================== -->
      <!-- شاشة (1): معالج إعداد المناسبة (Wizard)    -->
      <!-- ========================================== -->
      <section id="screen-wizard" class="space-y-4">
        <div>
          <h2 class="text-base font-extrabold text-slate-800">شنو مناسبتك القادمة؟ 🎉</h2>
          <p class="text-xs text-slate-500 mt-0.5">حدد التفاصيل لنعرضلك الخيارات المتوافقة</p>
        </div>

        <!-- أنواع المناسبات -->
        <div class="grid grid-cols-3 gap-2">
          <button class="occasion-btn p-2.5 rounded-2xl border-2 border-amber-500 bg-amber-50/80 flex flex-col items-center gap-1.5 transition active:scale-95" data-occasion="عيد ميلاد">
            <span class="text-2xl">🎂</span>
            <span class="text-xs font-bold text-slate-900">عيد ميلاد</span>
          </button>
          <button class="occasion-btn p-2.5 rounded-2xl border border-slate-200 bg-white flex flex-col items-center gap-1.5 transition active:scale-95" data-occasion="افتتاح عيادة">
            <span class="text-2xl">🏥</span>
            <span class="text-xs font-semibold text-slate-600">افتتاح عيادة</span>
          </button>
          <button class="occasion-btn p-2.5 rounded-2xl border border-slate-200 bg-white flex flex-col items-center gap-1.5 transition active:scale-95" data-occasion="تخرج">
            <span class="text-2xl">🎓</span>
            <span class="text-xs font-semibold text-slate-600">تخرج</span>
          </button>
          <button class="occasion-btn p-2.5 rounded-2xl border border-slate-200 bg-white flex flex-col items-center gap-1.5 transition active:scale-95" data-occasion="خطوبة/حنة">
            <span class="text-2xl">💍</span>
            <span class="text-xs font-semibold text-slate-600">خطوبة / حنة</span>
          </button>
          <button class="occasion-btn p-2.5 rounded-2xl border border-slate-200 bg-white flex flex-col items-center gap-1.5 transition active:scale-95" data-occasion="ختان">
            <span class="text-2xl">👶</span>
            <span class="text-xs font-semibold text-slate-600">ختان طفل</span>
          </button>
          <button class="occasion-btn p-2.5 rounded-2xl border border-slate-200 bg-white flex flex-col items-center gap-1.5 transition active:scale-95" data-occasion="اجتماع/عمل">
            <span class="text-2xl">💼</span>
            <span class="text-xs font-semibold text-slate-600">اجتماع عمل</span>
          </button>
        </div>

        <!-- الموعد والوقت -->
        <div class="grid grid-cols-2 gap-2">
          <div class="bg-white p-2.5 rounded-2xl border border-slate-200">
            <label class="text-[10px] font-bold text-slate-400 block mb-1">تاريخ المناسبة</label>
            <input type="date" value="2026-11-20" class="text-xs font-bold text-slate-800 w-full outline-none bg-transparent">
          </div>
          <div class="bg-white p-2.5 rounded-2xl border border-slate-200">
            <label class="text-[10px] font-bold text-slate-400 block mb-1">وقت البدء</label>
            <input type="time" value="19:00" class="text-xs font-bold text-slate-800 w-full outline-none bg-transparent">
          </div>
        </div>

        <!-- عدد الضيوف -->
        <div class="bg-white p-3.5 rounded-2xl border border-slate-200 shadow-sm">
          <div class="flex justify-between items-center mb-1.5">
            <span class="text-xs font-bold text-slate-700">عدد الحضور المتوقع:</span>
            <span class="text-sm font-black text-amber-600" id="guest-count-label">35 شخص</span>
          </div>
          <input type="range" min="10" max="300" step="5" value="35" class="w-full accent-amber-500 cursor-pointer" id="guest-slider">
        </div>

        <!-- المفترق المفصلي: الخيارين -->
        <div class="space-y-2.5 pt-2">
          <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider">حدد مسار المناسبة:</h3>

          <!-- المسار 1: المكان + الخدمات -->
          <div onclick="navigateTo('screen-venue-profile')" class="cursor-pointer bg-white p-4 rounded-2xl border-2 border-slate-200 hover:border-amber-500 shadow-sm transition active:scale-98 flex items-center justify-between group">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-2xl bg-amber-100 text-amber-600 flex items-center justify-center text-xl shadow-inner">
                <i class="fa-solid fa-hotel"></i>
              </div>
              <div>
                <h4 class="text-xs font-extrabold text-slate-900 group-hover:text-amber-600 transition">المكان + الخدمات 🏢</h4>
                <p class="text-[11px] text-slate-500 mt-0.5">مطاعم، قاعات، حدائق وفنادق مع الأكل</p>
              </div>
            </div>
            <i class="fa-solid fa-chevron-left text-slate-300 group-hover:text-amber-500 transition text-sm"></i>
          </div>

          <!-- المسار 2: خدمات فقط -->
          <div onclick="navigateTo('screen-services-menu')" class="cursor-pointer bg-white p-4 rounded-2xl border-2 border-slate-200 hover:border-blue-500 shadow-sm transition active:scale-98 flex items-center justify-between group">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-2xl bg-blue-100 text-blue-600 flex items-center justify-center text-xl shadow-inner">
                <i class="fa-solid fa-truck-ramp-box"></i>
              </div>
              <div>
                <h4 class="text-xs font-extrabold text-slate-900 group-hover:text-blue-600 transition">عندي المكان (خدمات فقط) 🏡</h4>
                <p class="text-[11px] text-slate-500 mt-0.5">كيك، كادر تقديم وضيافة، لايف ستيشن</p>
              </div>
            </div>
            <i class="fa-solid fa-chevron-left text-slate-300 group-hover:text-blue-500 transition text-sm"></i>
          </div>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- شاشة (2-أ): المسار الأول (صاج الريف)       -->
      <!-- ========================================== -->
      <section id="screen-venue-profile" class="hidden space-y-4">
        <button onclick="navigateTo('screen-wizard')" class="text-xs font-bold text-slate-500 hover:text-slate-800 flex items-center gap-1.5 transition">
          <i class="fa-solid fa-arrow-right"></i> الرجوع لتعديل البيانات
        </button>

        <!-- بروفايل المكان -->
        <div class="bg-white rounded-3xl overflow-hidden shadow-sm border border-slate-200">
          <div class="h-36 bg-gradient-to-tr from-slate-900 via-slate-800 to-amber-900 flex items-center justify-center relative p-4 text-center">
            <div>
              <span class="text-amber-400 text-xs font-bold uppercase tracking-wider block">مطاعم ومناسبات عائلية</span>
              <h3 class="text-white font-black text-lg mt-0.5">مطعم صاج الريف - المنصور</h3>
            </div>
            <span class="absolute bottom-2.5 right-3 bg-black/60 backdrop-blur-md text-amber-400 text-[10px] font-bold px-2.5 py-1 rounded-full">
              ⭐ 4.9 (140 تقييم)
            </span>
          </div>
          <div class="p-3.5 flex justify-between items-center text-xs text-slate-600 bg-slate-50/50 border-t border-slate-100">
            <span><i class="fa-solid fa-users text-amber-500 ml-1"></i> سعة القاعة: 20 - 70 شخص</span>
            <span><i class="fa-solid fa-location-dot text-rose-500 ml-1"></i> بغداد - المنصور</span>
          </div>
        </div>

        <!-- تبويبات خدمات المكان -->
        <div class="flex border-b border-slate-200 text-xs">
          <button id="tab-btn-offers" onclick="toggleVenueTab('offers')" class="flex-1 pb-2.5 font-black text-amber-600 border-b-2 border-amber-600">عروض لمّة الخاصة 🏷️</button>
          <button id="tab-btn-menu" onclick="toggleVenueTab('menu')" class="flex-1 pb-2.5 font-bold text-slate-400 hover:text-slate-700">قائمة الطعام (أفراد)</button>
        </div>

        <!-- محتوى تبويب العروض الحصرية -->
        <div id="venue-offers-tab" class="space-y-3">
          <div class="bg-gradient-to-bl from-amber-500 to-amber-600 text-slate-950 p-4 rounded-3xl shadow-lg relative overflow-hidden">
            <span class="bg-slate-950 text-amber-400 text-[10px] font-black px-2.5 py-1 rounded-full inline-block mb-2">عرض حصري لمستخدمي لمّة (-20%)</span>
            <h4 class="font-black text-base leading-snug">سيت منيو أعياد الميلاد والمناسبات</h4>
            <p class="text-xs text-slate-900 mt-1 font-medium">30 وجبة شاورما صاج مكس + ماعونين مقبلات ملكية + مشروبات غازية + كيكة مجانية من المطعم.</p>
            <div class="mt-4 flex justify-between items-center pt-2 border-t border-amber-400/40">
              <div>
                <span class="text-xs line-through text-slate-800/80 block">300,000 د.ع</span>
                <span class="text-base font-black text-slate-950">240,000 د.ع</span>
              </div>
              <button onclick="addToCartAndCheckout('سيت منيو صاج الريف للمناسبات', 240000, 'مطعم صاج الريف - المنصور')" class="bg-slate-950 hover:bg-slate-800 text-white font-extrabold text-xs px-4 py-2.5 rounded-2xl shadow transition active:scale-95">
                حجز هذه الباقة +
              </button>
            </div>
          </div>
        </div>

        <!-- محتوى تبويب المنيو بالقطعة -->
        <div id="venue-menu-tab" class="hidden space-y-2.5">
          <div class="bg-white p-3 rounded-2xl border border-slate-200 flex justify-between items-center">
            <div>
              <h5 class="text-xs font-bold text-slate-900">وجبة صاج لحم عراقي سوبر</h5>
              <span class="text-xs text-amber-600 font-extrabold">6,500 د.ع</span>
            </div>
            <button onclick="addToCartAndCheckout('وجبات صاج لحم عراقي فردي', 6500, 'صاج الريف')" class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-amber-500 hover:text-white flex items-center justify-center text-xs font-bold transition">
              +
            </button>
          </div>
          <div class="bg-white p-3 rounded-2xl border border-slate-200 flex justify-between items-center">
            <div>
              <h5 class="text-xs font-bold text-slate-900">ماعون مشويات مشكل فاخر</h5>
              <span class="text-xs text-amber-600 font-extrabold">14,000 د.ع</span>
            </div>
            <button onclick="addToCartAndCheckout('مشاوي مشكل عائلي', 14000, 'صاج الريف')" class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-amber-500 hover:text-white flex items-center justify-center text-xs font-bold transition">
              +
            </button>
          </div>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- شاشة (2-ب): المسار الثاني (خدمات فقط)       -->
      <!-- ========================================== -->
      <section id="screen-services-menu" class="hidden space-y-3.5">
        <button onclick="navigateTo('screen-wizard')" class="text-xs font-bold text-slate-500 hover:text-slate-800 flex items-center gap-1.5 transition">
          <i class="fa-solid fa-arrow-right"></i> الرجوع للرئيسية
        </button>

        <div>
          <h2 class="text-sm font-extrabold text-slate-800">تجهيزات موقعك الخاص 🏡</h2>
          <p class="text-[11px] text-slate-500">اختر الكوادر والخدمات المناسبة لعيادتك أو حفلتك</p>
        </div>

        <!-- 1. محلات الكيك والمنتجات -->
        <div class="bg-white p-3.5 rounded-3xl border border-slate-200 shadow-sm flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-11 h-11 rounded-2xl bg-pink-100 text-pink-600 flex items-center justify-center text-xl shadow-inner">🎂</div>
            <div>
              <h4 class="text-xs font-black text-slate-900">محلات الكيك والتجهيزات</h4>
              <p class="text-[10px] text-slate-500">قوالب مخصصة، شموع، توزيعات ختان</p>
            </div>
          </div>
          <button onclick="addToCartAndCheckout('قالب كيك افتتاح مخصص (حجم كبير)', 45000, 'محل كيك توليب')" class="text-xs bg-slate-900 hover:bg-amber-500 hover:text-slate-950 text-white px-3 py-2 rounded-xl font-bold transition">
            إضافة كيكة (45 ألف)
          </button>
        </div>

        <!-- 2. كوادر الضيافة والخدمة -->
        <div class="bg-white p-3.5 rounded-3xl border border-slate-200 shadow-sm flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-11 h-11 rounded-2xl bg-purple-100 text-purple-600 flex items-center justify-center text-xl shadow-inner">🤵</div>
            <div>
              <h4 class="text-xs font-black text-slate-900">كوادر ضيافة وتقديم (ويترز)</h4>
              <p class="text-[10px] text-slate-500">شباب وبنات زي رسمي لافتتاح العيادات</p>
            </div>
          </div>
          <button onclick="addToCartAndCheckout('كادر ضيافة ويترز (3 شباب - 4 ساعات)', 120000, 'شركة النخبة للضيافة')" class="text-xs bg-slate-900 hover:bg-amber-500 hover:text-slate-950 text-white px-3 py-2 rounded-xl font-bold transition">
            حجز كادر (120 ألف)
          </button>
        </div>

        <!-- 3. لايف ستيشن وعربات -->
        <div class="bg-white p-3.5 rounded-3xl border border-slate-200 shadow-sm flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-11 h-11 rounded-2xl bg-amber-100 text-amber-600 flex items-center justify-center text-xl shadow-inner">🎪</div>
            <div>
              <h4 class="text-xs font-black text-slate-900">محطات طهي وعربات لايف</h4>
              <p class="text-[10px] text-slate-500">شيف شاورما، مشويات، عربات قهوة</p>
            </div>
          </div>
          <button onclick="addToCartAndCheckout('عربة قهوة مختصة لايف بموقعك (50 كوب)', 180000, 'بار القهوة المتنقل')" class="text-xs bg-slate-900 hover:bg-amber-500 hover:text-slate-950 text-white px-3 py-2 rounded-xl font-bold transition">
            عربة قهوة (180 ألف)
          </button>
        </div>

        <!-- كرت بارز لشيف الشاورما -->
        <div class="p-4 bg-gradient-to-r from-slate-900 to-slate-800 text-white rounded-3xl shadow-md flex justify-between items-center mt-3">
          <div>
            <span class="text-amber-400 text-[10px] font-black uppercase">الخدمة الأكثر طلباً 🔥</span>
            <h5 class="text-xs font-black mt-0.5">شيف شاورما لايف بموقعك</h5>
            <span class="text-[10px] text-slate-300 block">سيخ شاورما كامل + صمون فريش ومقبلات</span>
          </div>
          <button onclick="addToCartAndCheckout('محطة شيف شاورما لايف بموقعك', 320000, 'فريق الشاورما الملكية')" class="bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-black px-3 py-2 rounded-xl transition">
            حجز (320 ألف)
          </button>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- شاشة (3): السلة وتأكيد الحجز (Checkout)    -->
      <!-- ========================================== -->
      <section id="screen-checkout-view" class="hidden space-y-4">
        <button onclick="navigateTo('screen-wizard')" class="text-xs font-bold text-slate-500 hover:text-slate-800 flex items-center gap-1.5 transition">
          <i class="fa-solid fa-arrow-right"></i> البدء من جديد
        </button>

        <div class="bg-white p-4 rounded-3xl border border-slate-200 shadow-sm space-y-3">
          <div class="flex justify-between items-center border-b border-slate-100 pb-2">
            <h3 class="text-xs font-black text-slate-800">تفاصيل حجز المناسبة 📋</h3>
            <span class="text-[10px] bg-emerald-100 text-emerald-800 font-bold px-2 py-0.5 rounded-full">حجز أولي مؤكد</span>
          </div>
          
          <div class="space-y-1.5 text-xs">
            <div class="flex justify-between text-slate-600">
              <span id="cart-item-name">سيت منيو صاج الريف</span>
              <span class="font-extrabold text-slate-900" id="cart-item-price">240,000 د.ع</span>
            </div>
            <div class="flex justify-between text-slate-500 text-[11px]">
              <span>مزود الخدمة:</span>
              <span class="font-bold text-slate-700" id="cart-vendor-name">صاج الريف</span>
            </div>
            <div class="flex justify-between text-slate-500 text-[11px]">
              <span>رسوم المنصة والتنسيق:</span>
              <span class="font-bold text-emerald-600">مجاناً (عرض لمّة) 🎁</span>
            </div>
            <div class="border-t border-slate-100 pt-2 flex justify-between text-sm font-black text-slate-900">
              <span>المجموع الكلي:</span>
              <span class="text-amber-600" id="cart-total-price">240,000 د.ع</span>
            </div>
          </div>
        </div>

        <!-- حساب العربون والمتبقي -->
        <div class="bg-amber-50 border border-amber-200 p-3.5 rounded-3xl">
          <div class="flex justify-between items-center text-xs">
            <span class="font-bold text-slate-800">العربون المطلوب لتثبيت الموعد:</span>
            <span class="font-black text-amber-700 text-base" id="cart-deposit-price">50,000 د.ع</span>
          </div>
          <div class="flex justify-between items-center text-[11px] text-slate-500 mt-1 border-t border-amber-200/60 pt-1">
            <span>المبلغ المتبقي يوم المناسبة:</span>
            <span class="font-bold text-slate-800" id="cart-remaining-price">190,000 د.ع</span>
          </div>
        </div>

        <!-- طرق الدفع -->
        <div>
          <label class="text-xs font-extrabold text-slate-700 block mb-2">طريقة دفع العربون:</label>
          <div class="grid grid-cols-2 gap-2">
            <button class="p-2.5 border-2 border-slate-950 bg-white rounded-2xl text-xs font-black text-slate-900 flex items-center justify-center gap-2 shadow-sm">
              <span class="w-2.5 h-2.5 bg-emerald-500 rounded-full animate-pulse"></span> زين كاش (ZainCash)
            </button>
            <button class="p-2.5 border border-slate-200 bg-white rounded-2xl text-xs font-bold text-slate-400 flex items-center justify-center gap-1.5">
              ماستركارد / كي كارد
            </button>
          </div>
        </div>

        <!-- زر الدفع النهائي -->
        <button onclick="confirmOrderAlert()" class="w-full bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-black text-xs py-3.5 rounded-2xl shadow-lg transition active:scale-95 flex items-center justify-center gap-2">
          <span>تأكيد الحجز ودفع العربون</span>
          <i class="fa-solid fa-lock text-[10px]"></i>
        </button>
      </section>

    </main>

    <!-- شريط التنقل السفلي الثابت (Bottom Nav Bar) -->
    <nav class="h-14 bg-white border-t border-slate-200 flex items-center justify-around text-slate-400 text-[10px] px-3 select-none">
      <button onclick="navigateTo('screen-wizard')" class="flex flex-col items-center gap-1 text-amber-600 font-extrabold">
        <i class="fa-solid fa-wand-magic-sparkles text-base"></i>
        <span>رتّب لمّتك</span>
      </button>
      <button onclick="alert('قسم مناسباتي وحجوزاتي السابقة والمؤكدة')" class="flex flex-col items-center gap-1 hover:text-slate-800 font-medium">
        <i class="fa-regular fa-calendar-check text-base"></i>
        <span>حجوزاتي</span>
      </button>
      <button onclick="alert('الملف الشخصي، طرق الدفع المحفوظة، والمساعدة')" class="flex flex-col items-center gap-1 hover:text-slate-800 font-medium">
        <i class="fa-regular fa-user text-base"></i>
        <span>حسابي</span>
      </button>
    </nav>

  </div>

  <!-- جافاسكربت المنطق والتنقل التفاعلي (Interactive App Logic) -->
  <script>
    let currentBooking = {
      title: 'سيت منيو صاج الريف',
      price: 240000,
      vendor: 'مطعم صاج الريف - المنصور'
    };

    function navigateTo(screenId) {
      const screens = ['screen-wizard', 'screen-venue-profile', 'screen-services-menu', 'screen-checkout-view'];
      screens.forEach(id => document.getElementById(id).classList.add('hidden'));
      document.getElementById(screenId).classList.remove('hidden');
      document.getElementById('main-content').scrollTop = 0;
    }

    function toggleVenueTab(tab) {
      if (tab === 'offers') {
        document.getElementById('venue-offers-tab').classList.remove('hidden');
        document.getElementById('venue-menu-tab').classList.add('hidden');
        document.getElementById('tab-btn-offers').className = 'flex-1 pb-2.5 font-black text-amber-600 border-b-2 border-amber-600';
        document.getElementById('tab-btn-menu').className = 'flex-1 pb-2.5 font-bold text-slate-400 hover:text-slate-700';
      } else {
        document.getElementById('venue-offers-tab').classList.add('hidden');
        document.getElementById('venue-menu-tab').classList.remove('hidden');
        document.getElementById('tab-btn-offers').className = 'flex-1 pb-2.5 font-bold text-slate-400 hover:text-slate-700';
        document.getElementById('tab-btn-menu').className = 'flex-1 pb-2.5 font-black text-amber-600 border-b-2 border-amber-600';
      }
    }

    function addToCartAndCheckout(title, price, vendor) {
      currentBooking.title = title;
      currentBooking.price = price;
      currentBooking.vendor = vendor;

      const deposit = Math.round(price * 0.25);
      const remaining = price - deposit;

      document.getElementById('cart-item-name').innerText = title;
      document.getElementById('cart-item-price').innerText = price.toLocaleString('ar-IQ') + ' د.ع';
      document.getElementById('cart-total-price').innerText = price.toLocaleString('ar-IQ') + ' د.ع';
      document.getElementById('cart-vendor-name').innerText = vendor;
      document.getElementById('cart-deposit-price').innerText = deposit.toLocaleString('ar-IQ') + ' د.ع';
      document.getElementById('cart-remaining-price').innerText = remaining.toLocaleString('ar-IQ') + ' د.ع';

      navigateTo('screen-checkout-view');
    }

    function confirmOrderAlert() {
      alert('تم حجز لمّتك بنجاح! 🎉\nسيصلك إشعار واتساب فوري برقم الحجز ورابط التتبع.');
      navigateTo('screen-wizard');
    }

    // تفعيل أزرار أنواع المناسبات
    document.querySelectorAll('.occasion-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        document.querySelectorAll('.occasion-btn').forEach(b => {
          b.className = 'occasion-btn p-2.5 rounded-2xl border border-slate-200 bg-white flex flex-col items-center gap-1.5 transition active:scale-95';
          b.querySelector('span:last-child').className = 'text-xs font-semibold text-slate-600';
        });
        this.className = 'occasion-btn p-2.5 rounded-2xl border-2 border-amber-500 bg-amber-50/80 flex flex-col items-center gap-1.5 transition active:scale-95';
        this.querySelector('span:last-child').className = 'text-xs font-bold text-slate-900';
      });
    });

    // تحديث عدد الضيوف
    document.getElementById('guest-slider').addEventListener('input', function() {
      document.getElementById('guest-count-label').innerText = this.value + ' شخص';
    });
  </script>
</body>
</html>